{
  "name": "@ossl/genesis-plugins",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "import": "./dist/plugins/node/index.js",
      "types": "./dist/plugins/node/index.d.ts"
    },
    "./python": {
      "import": "./dist/plugins/python/index.js",
      "types": "./dist/plugins/python/index.d.ts"
    },
    "./java": {
      "import": "./dist/plugins/java/index.js",
      "types": "./dist/plugins/java/index.d.ts"
    },
    "./go": {
      "import": "./dist/plugins/go/index.js",
      "types": "./dist/plugins/go/index.d.ts"
    },
    "./git": {
      "import": "./dist/plugins/git/index.js",
      "types": "./dist/plugins/git/index.d.ts"
    },
    "./docker": {
      "import": "./dist/plugins/docker/index.js",
      "types": "./dist/plugins/docker/index.d.ts"
    },
    "./homebrew": {
      "import": "./dist/plugins/homebrew/index.js",
      "types": "./dist/plugins/homebrew/index.d.ts"
    },
    "./bun": {
      "import": "./dist/plugins/bun/index.js",
      "types": "./dist/plugins/bun/index.d.ts"
    },
    "./deno": {
      "import": "./dist/plugins/deno/index.js",
      "types": "./dist/plugins/deno/index.d.ts"
    },
    "./pnpm": {
      "import": "./dist/plugins/pnpm/index.js",
      "types": "./dist/plugins/pnpm/index.d.ts"
    },
    "./yarn": {
      "import": "./dist/plugins/yarn/index.js",
      "types": "./dist/plugins/yarn/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@ossl/genesis-core": "workspace:*",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsup": "^8.0.0",
    "eslint": "^9.0.0",
    "@types/node": "^22.0.0",
    "vitest": "^2.0.0"
  }
}
